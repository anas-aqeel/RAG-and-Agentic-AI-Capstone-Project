# ============================================
# Google Vertex AI Configuration
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east5

# ============================================
# Anthropic Claude via Vertex AI
# ============================================
# Models available:
#   claude-sonnet-4-6@20260401    (primary - $3/1M input, $15/1M output)
#   claude-haiku-4-5@20251001     (fast/cheap - $0.80/1M input, $4/1M output)
#   claude-opus-4-6@20260401      (powerful - $15/1M input, $75/1M output)
CLAUDE_MODEL=claude-sonnet-4-6@20260401

# ============================================
# IBM watsonx (if needed for course labs)
# ============================================
# WATSONX_API_KEY=your-watsonx-api-key
# WATSONX_PROJECT_ID=your-watsonx-project-id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================
# OpenAI (if needed for embeddings)
# ============================================
# OPENAI_API_KEY=your-openai-api-key

# ============================================
# LangChain
# ============================================
# LANGCHAIN_API_KEY=your-langchain-api-key
# LANGCHAIN_TRACING_V2=true
